2# Kegelkasse — Beispiel-Umgebungsvariablen (lokale Entwicklung)
# Werte stammen aus dem Output von `supabase start`.
# Kopieren nach prototype/.env.local (Frontend) bzw. setzen in Supabase Secrets.

# --- Frontend (React+Vite, via import.meta.env.VITE_*) ---
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=

# --- Edge Functions / serverseitig (NIE ins Frontend!) ---
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@kegelkasse.de

# development -> E-Mails nur in Konsole; production -> echter Resend-Versand
ENVIRONMENT=development
