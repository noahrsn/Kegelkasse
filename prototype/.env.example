# Kegelkasse Frontend — benötigte Umgebungsvariablen (Vite)
# Kopieren nach prototype/.env.local für lokale Entwicklung; in Render als
# Service-Env-Vars setzen (siehe render.yaml). VITE_*-Werte werden zur Build-Zeit
# in das Bundle eingebacken.
#
# Fehlen die Werte, läuft die App im Mock-Modus (Prototyp ohne Backend).

# URL des Supabase-Cloud-Projekts.
VITE_SUPABASE_URL=https://zezizdnvjpbnhntpzvpt.supabase.co

# Öffentlicher anon/publishable Key (Supabase Dashboard → Project Settings → API).
# Kein Geheimnis (RLS schützt die Daten), aber nicht ins Repo committen.
VITE_SUPABASE_ANON_KEY=
